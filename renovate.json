{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Rebuild runner promptly when upstream actions-runner moves",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/actions/actions-runner"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
